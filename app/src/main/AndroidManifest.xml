<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Голосовой ввод запрашивается runtime-разрешением (Этап 5/6) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Напоминания о тренировке: runtime-разрешение на API 33+ (Этап 7) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Работа без интернета: разрешение не требуется -->

    <application
        android:name=".QuickJokesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickJokes">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickJokes"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
